# ---------- Postgres (docker compose up -d postgres) ----------
DATABASE_URL=postgres://sync:sync@localhost:5433/sync

# ---------- Mini-ERP ----------
ERP_PORT=8787
ERP_BASE_URL=http://localhost:8787
# API key the app/worker sends in X-Api-Key
ERP_API_KEY=dev-erp-api-key-change-me
# HMAC secret for ERP -> app callbacks (shipment)
ERP_CALLBACK_SECRET=dev-callback-secret-change-me
# Callback URL on the Shopify app side
APP_CALLBACK_URL=http://localhost:3000/webhooks/erp
# Secret used to derive pseudonyms for the demo role
DEMO_PSEUDONYM_SECRET=dev-pseudonym-secret-change-me
# Better Auth
BETTER_AUTH_SECRET=dev-better-auth-secret-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:8787
# Accounts created by the seed
ERP_ADMIN_EMAIL=admin@example.com
ERP_ADMIN_PASSWORD=admin-password-change-me
ERP_DEMO_EMAIL=demo@example.com
ERP_DEMO_PASSWORD=demo-password-change-me

# ---------- Worker ----------
WORKER_CONCURRENCY=3
LOG_LEVEL=info

# ---------- Worker access to the Admin API ----------
# SHOPIFY_SHOP plus either a static token (shpat_...) or a Dev Dashboard app's
# client ID and secret (client credentials grant, same organization as the store).
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ---------- App Shopify (shopify app dev fills in SHOPIFY_*) ----------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_orders,write_orders,read_products
